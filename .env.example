# MLflow tracking (DagsHub managed MLflow)
MLFLOW_TRACKING_URI=https://dagshub.com/<your-dagshub-user>/Home-Credit-Default-Risk-Prediction.mlflow
MLFLOW_TRACKING_USERNAME=<your-dagshub-user>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>

# DagsHub token (DVC remote auth)
DAGSHUB_USER_TOKEN=<dagshub-token>
DAGSHUB_REPO_OWNER=<your-github-username>
DAGSHUB_REPO_NAME=Home-Credit-Default-Risk-Prediction

# Data location (defaults to ./data/raw when unset)
HC_DATA=./data/raw

# Random seed for reproducibility
RANDOM_STATE=42

# Model registry stage to load in API (Staging|Production)
MODEL_STAGE=Staging